#!/opt/python314/bin/python3.14
"""Disassemble Python 3.14 marshal/code objects without executing them."""

from __future__ import annotations

import argparse
import dis
import importlib.util
import marshal
from pathlib import Path
import reprlib
import sys
import types

MAX_INPUT_BYTES = 64 * 1024 * 1024
MAX_CODE_OBJECTS = 4096
MAX_CODE_BYTES = 8 * 1024 * 1024


def bounded_repr(value: object) -> str:
    renderer = reprlib.Repr()
    renderer.maxstring = 4096
    renderer.maxother = 4096
    renderer.maxtuple = 256
    renderer.maxlist = 256
    renderer.maxdict = 128
    return renderer.repr(value)


def code_objects(root: types.CodeType):
    pending = [("<module>", root)]
    seen: set[int] = set()
    while pending:
        path, code = pending.pop()
        if id(code) in seen:
            continue
        seen.add(id(code))
        if len(seen) > MAX_CODE_OBJECTS:
            raise ValueError(f"more than {MAX_CODE_OBJECTS} nested code objects")
        yield path, code
        children = [item for item in code.co_consts if isinstance(item, types.CodeType)]
        for index, child in reversed(list(enumerate(children))):
            pending.append((f"{path}/{child.co_qualname or child.co_name}#{index}", child))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("file", type=Path)
    parser.add_argument("--raw", action="store_true", help="input begins with a raw marshal object")
    parser.add_argument("--offset", type=lambda value: int(value, 0), default=0)
    args = parser.parse_args()

    try:
        size = args.file.stat().st_size
        if size > MAX_INPUT_BYTES:
            parser.error(f"input exceeds the {MAX_INPUT_BYTES}-byte safety limit")
        data = args.file.read_bytes()
    except OSError as error:
        print(f"pyc-disasm: could not read input: {error}", file=sys.stderr)
        return 2
    if args.offset < 0 or args.offset >= len(data):
        parser.error("offset is outside the input")
    data = data[args.offset:]
    if not args.raw:
        if len(data) < 16:
            parser.error("pyc input is shorter than the 16-byte header")
        if data[:4] != importlib.util.MAGIC_NUMBER:
            parser.error(
                f"pyc magic {data[:4].hex()} does not match Python 3.14 magic "
                f"{importlib.util.MAGIC_NUMBER.hex()}; use --raw or the matching decoder"
            )
        data = data[16:]
    try:
        value = marshal.loads(data)
    except (EOFError, MemoryError, TypeError, ValueError) as error:
        print(f"pyc-disasm: marshal decode failed: {error}", file=sys.stderr)
        return 2
    if not isinstance(value, types.CodeType):
        print(f"pyc-disasm: root object is {type(value).__name__}, not a code object", file=sys.stderr)
        return 2

    try:
        for path, code in code_objects(value):
            print(f"\n# === {bounded_repr(path)} ===")
            print(
                f"# file={bounded_repr(code.co_filename)} "
                f"name={bounded_repr(code.co_qualname)} firstlineno={code.co_firstlineno}"
            )
            print(f"# names={bounded_repr(code.co_names)}")
            constants = tuple(item for item in code.co_consts if not isinstance(item, types.CodeType))
            print(f"# constants={bounded_repr(constants)}")
            if len(code.co_code) > MAX_CODE_BYTES:
                print(f"# bytecode omitted: {len(code.co_code)} bytes exceeds safety limit")
                continue
            dis.dis(code, show_caches=True, adaptive=False)
    except (MemoryError, TypeError, ValueError) as error:
        print(f"pyc-disasm: disassembly failed: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
