#!/bin/bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compile_only=false
if [ "${1:-}" = "--compile-only" ]; then
    compile_only=true
    shift
fi
if [ "$#" -ne 1 ] || [[ "$1" != /* ]]; then
    echo "usage: scripts/jaq-harvest [--compile-only] /absolute/path/to/existing/run" >&2
    exit 64
fi

run_path="$1"
if [ ! -f "$run_path/observations.jsonl" ]; then
    echo "run must contain observations.jsonl" >&2
    exit 66
fi

cd "$project_root"
if [ -f .venv/bin/activate ]; then
    source .venv/bin/activate
fi
if [ "$compile_only" = false ] && [ -f .env ]; then
    set -a
    source .env
    set +a
fi

export PYTHONPATH="$project_root/python${PYTHONPATH:+:$PYTHONPATH}"
if [ "$compile_only" = true ]; then
    exec "${JAQ_PYTHON:-python3}" -m jaq_investigator \
        --evidence "$run_path/observations.jsonl" \
        --output "$run_path" \
        --compile-only
fi
if [ ! -f "$run_path/research.json" ]; then
    echo "jaq: recovering research checkpoint from persisted evidence" >&2
    "${JAQ_PYTHON:-python3}" -m jaq_investigator \
        --evidence "$run_path/observations.jsonl" \
        --output "$run_path" \
        --finalize-research-only
fi
exec "${JAQ_PYTHON:-python3}" -m jaq_investigator \
    --evidence "$run_path/observations.jsonl" \
    --output "$run_path" \
    --harvest-only
