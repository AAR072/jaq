#!/bin/bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "usage: scripts/jaq-run /absolute/path/sample.exe [/absolute/output/directory]" >&2
    exit 64
fi

sample_path="$1"
if [[ "$sample_path" != /* ]]; then
    echo "sample path must be absolute" >&2
    exit 64
fi

cd "$project_root"
if [ -f .venv/bin/activate ]; then
    source .venv/bin/activate
fi
if [ ! -f .env ]; then
    echo "missing $project_root/.env" >&2
    exit 78
fi
set -a
source .env
set +a

if [ -z "${JAQ_INVESTIGATOR_MODEL:-}" ] || [ -z "${DEEPSEEK_API_KEY:-}" ]; then
    echo ".env must define JAQ_INVESTIGATOR_MODEL and DEEPSEEK_API_KEY" >&2
    exit 78
fi

if ! docker info >/dev/null 2>&1; then
    if command -v orb >/dev/null 2>&1; then
        orb start
        for _ in {1..20}; do
            docker info >/dev/null 2>&1 && break
            sleep 1
        done
    fi
fi
if ! docker info >/dev/null 2>&1; then
    echo "Docker is unavailable; start OrbStack or Docker first" >&2
    exit 69
fi
if ! docker image inspect jaq-radare2:6.2.0-mcp1.8.6 >/dev/null 2>&1; then
    make sandbox-image
fi

if [ ! -x bin/jaq ]; then
    make build
fi

if [ "$#" -eq 2 ]; then
    output_path="$2"
else
    sample_name="$(basename "$sample_path")"
    sample_name="${sample_name%.*}"
    output_path="$project_root/runs/${sample_name}-$(date -u +%Y%m%dT%H%M%SZ)"
fi
if [[ "$output_path" != /* ]]; then
    echo "output path must be absolute" >&2
    exit 64
fi

exec "$project_root/bin/jaq" analyze --sample "$sample_path" --output "$output_path"
